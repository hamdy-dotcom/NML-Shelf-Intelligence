# Database — matches docker-compose defaults for local dev
DATABASE_URL=postgresql://nml:nml_dev_password@localhost:5432/nml_shelf

# Salla Partner API (OAuth2) — leave blank until Partner account is registered
# Docs: https://docs.salla.dev/docs/merchant/ZG9jOjI0NTU4MDI0-authentication
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_REFRESH_TOKEN=
SALLA_STORE_NAME=mock-store
SALLA_STORE_URL=
SALLA_TOKEN_URL=https://accounts.salla.sa/oauth2/token
SALLA_API_BASE_URL=https://api.salla.dev/admin/v2

# Set to true to use fixture data — safe to run with no Salla credentials
ORBIT_MOCK_MODE=true

# Run one pull immediately on app startup (useful in dev; set false in prod)
ORBIT_RUN_INITIAL_PULL=true

# Ingestion schedule (minutes)
ORBIT_SALLA_POLL_INTERVAL_MINUTES=15
ORBIT_AD_POLL_INTERVAL_MINUTES=60

# Meta Ad Library — leave blank until integration is activated
# Docs: https://developers.facebook.com/docs/marketing-api/reference/ads-archive/
META_AD_LIBRARY_ACCESS_TOKEN=

LOG_LEVEL=INFO
